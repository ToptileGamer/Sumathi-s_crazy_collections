[TEMPLATE]
# ──────────────────────────────────────────────
# Supabase (required)
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ──────────────────────────────────────────────
# EmailJS (required for contact form & custom orders)
# Get these from https://dashboard.emailjs.com
# ──────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ──────────────────────────────────────────────
# Razorpay (required for online payments)
# NOTE: these are set on the SUPABASE EDGE FUNCTIONS,
# not in the Vite build. Add them in:
#   Supabase Dashboard → Edge Functions → Secrets
# ──────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ──────────────────────────────────────────────
# Edge function CORS allow-list (comma separated)
# Set this to your PRODUCTION domain on the edge
# function secrets, e.g. https://sumathiscrazycollections.com
# If unset, only localhost origins are allowed.
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ──────────────────────────────────────────────
# Cloudflare Turnstile (OPTIONAL — contact form bot protection)
# 1. Create a site key + secret key: https://dash.cloudflare.com → Turnstile
# 2. VITE_TURNSTILE_SITE_KEY goes in your Vite .env
# 3. TURNSTILE_SECRET_KEY goes on the edge function secrets
# If not configured, the form still works (honeypot + rate limit remain active).
# ──────────────────────────────────────────────
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
